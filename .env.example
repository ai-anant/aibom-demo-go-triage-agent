# Copy to .env for local runs. Defaults to the offline stub provider.

AI_PROVIDER=openai
OPENAI_API_KEY=sk-replace-me
CHAT_MODEL=gpt-4o-mini
ESCALATION_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-sonnet-4-5
EMBEDDING_MODEL=text-embedding-3-small

# Local Ollama runtime
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Hugging Face (router for chat, inference API for embeddings/zero-shot)
HF_TOKEN=hf-replace-me
HF_CHAT_MODEL=meta-llama/Llama-3.1-8B-Instruct
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_ZERO_SHOT_MODEL=facebook/bart-large-mnli
HF_CHAT_BASE_URL=https://router.huggingface.co/v1
HF_INFERENCE_URL=https://api-inference.huggingface.co/models

ADDR=:8080
TEMPERATURE=0.1
MAX_TOKENS=700
TOP_K=3
